<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>netstandard2.0</TargetFramework>
    <RootNamespace>DefensiveCopyAnalyzer</RootNamespace>
    <AssemblyName>DefensiveCopyAnalyzer</AssemblyName>
    <IsRoslynComponent>true</IsRoslynComponent>
    <EnforceExtendedAnalyzerRules>true</EnforceExtendedAnalyzerRules>
    <IncludeBuildOutput>false</IncludeBuildOutput>
    <GeneratePackageOnBuild>false</GeneratePackageOnBuild>
    <DevelopmentDependency>true</DevelopmentDependency>
    <!-- RS1033: 中文句末标点不被启发式识别；RS1039/RS2008: 已按语义模型实际可用性调整。 -->
    <NoWarn>$(NoWarn);CS1591;RS1033;RS1034;RS1039;RS2008</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.CodeAnalysis.CSharp" Version="4.12.0" PrivateAssets="all" />
    <PackageReference Include="Microsoft.CodeAnalysis.Analyzers" Version="3.11.0" PrivateAssets="all" />
  </ItemGroup>

  <!-- 代码修复项目需要按 ID 字符串注册，ID 常量经 InternalsVisibleTo 共享。 -->
  <ItemGroup>
    <InternalsVisibleTo Include="DefensiveCopyAnalyzer.CodeFixes" />
  </ItemGroup>

</Project>
